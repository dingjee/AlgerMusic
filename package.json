{
  "name": "alger-music-player",
  "private": true,
  "version": "5.2.0",
  "description": "Alger Music —— Rust / Tauri 2 桌面版",
  "license": "MIT",
  "author": "Alger <algerkc@qq.com>",
  "repository": "https://github.com/algerkong/AlgerMusicPlayer",
  "workspaces": ["frontend"],
  "scripts": {
    "clean": "sh scripts/clean.sh",
    "install:dist": "sh scripts/install-dist.sh",
    "icons:generate": "sh scripts/generate-icons.sh",
    "test:cleanup": "bun tests/cleanup-acceptance.cjs",
    "dev": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "typecheck": "bun run --cwd frontend typecheck",
    "test": "bun run test:player && bun run test:playlist && bun run test:rust",
    "test:player": "bun tests/player-acceptance.cjs",
    "test:playlist": "bun tests/playlist-dialog-acceptance.cjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "bun run typecheck && bun run lint:rust",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.4.4"
}
