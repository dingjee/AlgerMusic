{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alger Music",
  "version": "5.2.0",
  "identifier": "com.alger.music",
  "mainBinaryName": "AlgerMusicPlayer",
  "build": {
    "beforeDevCommand": "sh scripts/dev-frontend.sh",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh scripts/build-frontend.sh",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Alger Music",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "copyright": "Copyright (c) 2024 Alger <algerkc@qq.com>",
    "licenseFile": "../LICENSE",
    "shortDescription": "Alger Music",
    "longDescription": "Alger Music —— Rust / Tauri 2 重写版，支持 Cookie 登录、歌单管理、搜索、播放、下载与第三方音源解析。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
